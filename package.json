{
  "name": "angular-i18n-tools",
  "version": "0.0.1",
  "private": true,
  "description": "Tooling for Angular built-in localization workflows.",
  "license": "MIT",
  "author": "Axel Jaeger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axeljaeger/angular-i18n-tools.git"
  },
  "bugs": {
    "url": "https://github.com/axeljaeger/angular-i18n-tools/issues"
  },
  "homepage": "https://github.com/axeljaeger/angular-i18n-tools#readme",
  "keywords": [
    "angular",
    "i18n",
    "localization",
    "translation",
    "storybook",
    "vscode",
    "github-action"
  ],
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "check:i18n": "pnpm --filter @angular-i18n-tools/core run build && node packages/core/dist/cli.js apps/sample-angular && node packages/core/dist/cli.js apps/sample-angular-nx",
    "dev:storybook": "pnpm --filter @angular-i18n-tools/sample-angular run storybook",
    "dev:vscode-web": "pnpm --dir packages/vscode-extension run dev:web",
    "watch:vscode": "pnpm --dir packages/vscode-extension run watch",
    "build:pages": "node scripts/pages/build.mjs",
    "test:pages": "node scripts/pages/test.mjs",
    "dev:storybook:nx": "pnpm exec nx run sample-angular-nx:storybook",
    "build:demo:nx": "pnpm exec nx run sample-angular-nx:build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "~6.0.0",
    "vitest": "^5.0.5",
    "nx": "24.0.3"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0",
    "pnpm": ">=11.0.0"
  }
}

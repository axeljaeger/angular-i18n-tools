{
  "name": "@angular-i18n-tools/sample-angular",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "author": "Axel Jaeger",
  "type": "module",
  "scripts": {
    "build": "ng build",
    "serve": "ng serve",
    "extract-i18n": "ng extract-i18n --format=json --output-path=src/locale --out-file=messages.en-US.json",
    "storybook": "node ../../scripts/with-workbench-port.mjs --offset 1 --fallback-port 6006 -- ng run sample-angular:storybook --port {port}",
    "build-storybook": "ng run sample-angular:build-storybook",
    "demo:storybook-addon": "node scripts/record-storybook-addon-demo.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test:storybook-static": "node scripts/test-storybook-static.mjs"
  },
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/localize": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "rxjs": "^7.8.0",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@angular-i18n-tools/storybook-addon": "workspace:*",
    "playwright": "^1.64.1",
    "storybook": "10.6.5",
    "typescript": "~6.0.0",
    "@storybook/angular-vite": "10.6.5",
    "@angular/build": "^22.2.5",
    "@analogjs/vite-plugin-angular": "^2.7.3",
    "vite": "^8.0.0"
  }
}

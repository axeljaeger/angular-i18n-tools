{
  "name": "Try Angular i18n Tools \u2014 Angular CLI",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24-bookworm",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/apps/sample-angular",
  "postCreateCommand": "bash ../../.devcontainer/demo/build.sh",
  "postAttachCommand": "bash ../../.devcontainer/demo/install.sh",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "apps/sample-angular/DEMO.md",
        "apps/sample-angular/src/app/settings-dialog/settings-dialog.component.html"
      ]
    },
    "vscode": {
      "settings": {
        "workbench.startupEditor": "none"
      }
    }
  }
}

{
  "name": "@angular-i18n-tools/ng-generator",
  "version": "0.0.4",
  "description": "Setup generator for Angular built-in runtime localization in Angular CLI and Nx workspaces.",
  "license": "MIT",
  "author": "Axel Jaeger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axeljaeger/angular-i18n-tools.git",
    "directory": "packages/ng-generator"
  },
  "bugs": {
    "url": "https://github.com/axeljaeger/angular-i18n-tools/issues"
  },
  "homepage": "https://github.com/axeljaeger/angular-i18n-tools#readme",
  "keywords": [
    "angular",
    "angular-cli",
    "schematics",
    "generator",
    "i18n",
    "localization",
    "translation"
  ],
  "type": "module",
  "schematics": "./collection.json",
  "files": [
    "collection.json",
    "dist",
    "src/runtime-localize/schema.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@angular-devkit/core": "^22.2.5",
    "@angular-devkit/schematics": "^22.2.5"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
